rules_version = '2';

// ============================================================================
// HumanConnect security rules.
//
// READ-ONLY FOR EVERY CLIENT. That is the whole file, and it is deliberate.
//
// Writes used to come straight from the browser, which meant the rules were
// the only thing shaping them — and rules cannot see an IP, cannot count how
// many events one person made yesterday, and cannot tell a second join from
// the same human apart from a first join by someone new. So "one join per
// person" and "a handful of events per day" were enforced in localStorage,
// which any visitor clears by opening an incognito window.
//
// Now every mutation goes through /api/* (Vercel), which:
//   - verifies a Cloudflare Turnstile token, so automation has to pay per write
//   - validates {a,b,c} against the same js/words.js the UI uses, so free text
//     still cannot enter the database (see api/_lib/validate.js — that file is
//     now where the legal-safety model lives)
//   - rate-limits on a server-derived identity a page cannot rewrite
// and writes with a service account, which bypasses these rules entirely.
//
// Anything that reaches Firestore *as a client* is therefore either a read or
// an attack, and this file answers accordingly.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The map. World-readable by design — that is the product.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-event server bookkeeping:
    //   priv/owner    — hash of the creator's remove-secret
    //   joiners/{who} — which networks/devices have been counted
    // Both exist purely so the API can answer "may this person do this?", and
    // neither is any client's business to read or touch.
    match /events/{eventId}/{sub}/{docId} {
      allow read, write: if false;
    }

    // Rate-limit buckets keyed by an opaque HMAC of the caller's network.
    // Readable by nobody: the whole point is that they cannot be inspected,
    // cleared, or pre-poisoned from a browser.
    match /limits/{bucket} {
      allow read, write: if false;
    }

    // Everything not matched above is denied.
  }
}
